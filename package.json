{
  "name": "pos-mockup",
  "private": true,
  "version": "0.0.0",
  "description": "Mockup HTML platform POS multi-vertikal (memakai design system Ordinara)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/copy-vendor.mjs && tailwindcss -i src/input.css -o dist/output.css --minify",
    "dev": "node scripts/copy-vendor.mjs && tailwindcss -i src/input.css -o dist/output.css --watch",
    "serve": "npx --yes serve . -l 5180"
  },
  "dependencies": {
    "@ordinara/icons": "0.1.0",
    "@ordinara/tokens": "0.1.0",
    "@ordinara/ui": "0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "flowbite": "^4.0.2"
  }
}
